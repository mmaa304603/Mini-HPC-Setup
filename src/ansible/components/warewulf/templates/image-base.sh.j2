{% for account in core_cluster.service_users %}
check_identity {{ account.name | quote }} {{ account.uid }} {{ account.group | quote }} {{ account.gid }}
{% endfor %}
{% for account in core_cluster.service_users %}
ensure_identity {{ account.name | quote }} {{ account.uid }} {{ account.group | quote }} {{ account.gid }} /var/lib/{{ account.name }} /sbin/nologin
{% endfor %}
install_packages epel-release
install_packages NetworkManager openssh-server openssh-clients python3 nfs-utils chrony
ensure_dir /root/.ssh 0700 root root
put_file /root/.ssh/authorized_keys 0600 root root <<'HPC_KEYS'
{{ (warewulf_authorized_keys + [warewulf_head_root_public_key.stdout | trim]) | unique | join('\n') }}
HPC_KEYS
# A unique persistent key is delivered by each node's hpc-ssh overlay.
put_file /etc/ssh/sshd_config.d/20-hpc-hostkey.conf 0644 root root <<'HPC_SSH'
HostKey /etc/ssh/ssh_host_ed25519_key
HPC_SSH
put_file /etc/chrony.conf 0644 root root <<'HPC_CHRONY'
server {{ core_cluster.head.address }} iburst
makestep 1.0 3
rtcsync
HPC_CHRONY
enable_service NetworkManager
enable_service sshd
enable_service chronyd
echo "HPC_CHANGED=$hpc_changed"
