# Trusted small-cluster deployment: APIs are accessible only on head loopback.
cluster.name: hpc-logs
node.name: hpc-head
network.host: 127.0.0.1
http.port: 9200
discovery.type: single-node
xpack.security.enabled: false
xpack.security.autoconfiguration.enabled: false
# RPM installation may have already stored TLS passwords in the keystore.
# Explicitly disable both layers for this loopback-only, non-TLS deployment.
xpack.security.http.ssl.enabled: false
xpack.security.transport.ssl.enabled: false
node.store.allow_mmap: false
path.data: /var/lib/elasticsearch
path.logs: /var/log/elasticsearch
