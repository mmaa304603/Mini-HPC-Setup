#!/bin/bash

# HPC Cluster Setup Orchestrator
# Main entry point for setting up HPC cluster components with checkpointing

# Source common functions and configuration
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
SHELL_DIR="$(dirname "$SCRIPT_DIR")"
source "${SHELL_DIR}/lib/functions.sh"
source "${SHELL_DIR}/lib/config.sh"
source "${SHELL_DIR}/lib/validate.sh"
source "${SHELL_DIR}/lib/checkpoint.sh"

# Function to create log directory
setup_logging() {
    mkdir -p "${LOG_DIR}"
    exec 1> >(tee -a "${LOG_DIR}/setup.log")
    exec 2> >(tee -a "${LOG_DIR}/setup.log" >&2)
    log_info "Logging initialized to ${LOG_DIR}/setup.log"
}

# Function to run installation scripts with checkpoints
run_installations() {
    local failed=0
    
    # Initialize checkpoint system
    init_checkpoints
    
    # Network setup (handled by Warewulf)
    if [ "${NETWORK_SETUP_ENABLED}" = true ]; then
        if ! verify_checkpoint "network_setup"; then
            log_info "Network setup is handled by Warewulf provisioning system..."
            log_info "Skipping separate network setup step"
            create_checkpoint "network_setup"
        else
            log_info "Network setup checkpoint found, skipping..."
        fi
    fi
    
    # Warewulf setup
    if [ "${WAREWULF_ENABLED}" = true ]; then
        if ! verify_checkpoint "warewulf_setup"; then
            log_info "Running Warewulf setup..."
            if ! "${SCRIPT_DIR}/warewulf/install.sh"; then
                log_error "Warewulf setup failed"
                failed=1
            else
                create_checkpoint "warewulf_setup"
            fi
        else
            log_info "Warewulf setup checkpoint found, skipping..."
        fi
    fi
    
    # SLURM setup
    if [ "${SLURM_ENABLED}" = true ]; then
        if ! verify_checkpoint "slurm_setup"; then
            log_info "Running SLURM setup..."
            if ! "${SHELL_DIR}/components/slurm/install.sh"; then
                log_error "SLURM setup failed"
                failed=1
            else
                create_checkpoint "slurm_setup"
            fi
        else
            log_info "SLURM setup checkpoint found, skipping..."
        fi
    fi
    
    # Spack setup
    if [ "${SPACK_ENABLED}" = true ]; then
        if ! verify_checkpoint "spack_setup"; then
            log_info "Running Spack setup..."
            if ! "${SHELL_DIR}/components/spack/install.sh"; then
                log_error "Spack setup failed"
                failed=1
            else
                create_checkpoint "spack_setup"
            fi
        else
            log_info "Spack setup checkpoint found, skipping..."
        fi
    fi
    
    # Monitoring setup
    if [ "${MONITORING_ENABLED}" = true ]; then
        if ! verify_checkpoint "monitoring_setup"; then
            log_info "Running monitoring setup..."
            if ! "${SHELL_DIR}/maintenance/setup.sh"; then
                log_error "Monitoring setup failed"
                failed=1
            else
                create_checkpoint "monitoring_setup"
            fi
        else
            log_info "Monitoring setup checkpoint found, skipping..."
        fi
    fi
    
    # Squid setup - removed, no longer needed with spack
    # if [ "${SQUID_ENABLED}" = true ]; then
    #     if ! verify_checkpoint "squid_setup"; then
    #         log_info "Running Squid setup..."
    #         if ! "${SCRIPT_DIR}/squid/setup.sh"; then
    #             log_error "Squid setup failed"
    #             failed=1
    #         else
    #             create_checkpoint "squid_setup"
    #         fi
    #     else
    #         log_info "Squid setup checkpoint found, skipping..."
    #     fi
    # fi
    
    # Apptainer setup
    if [ "${APPTAINER_ENABLED}" = true ]; then
        if ! verify_checkpoint "apptainer_setup"; then
            log_info "Running Apptainer setup..."
            if ! "${SHELL_DIR}/components/apptainer/install.sh"; then
                log_error "Apptainer setup failed"
                failed=1
            else
                create_checkpoint "apptainer_setup"
            fi
        else
            log_info "Apptainer setup checkpoint found, skipping..."
        fi
    fi
    
    return $failed
}

# Function to display usage information
show_usage() {
    cat << EOF
HPC Cluster Setup Orchestrator

USAGE:
    $0 [OPTIONS]

DESCRIPTION:
    Orchestrates the installation and configuration of HPC cluster components
    with built-in checkpointing for reliable deployment and recovery.

OPTIONS:
    --step COMPONENT     Install specific component (network|slurm|spack|monitoring|squid|apptainer|all)
    --list-checkpoints   List all available checkpoints
    --clear-checkpoint   Clear specific checkpoint
    --clear-all-checkpoints  Clear all checkpoints
    --help              Show this help message

EXAMPLES:
    $0 --step all                    # Install all components
    $0 --step slurm                  # Install only SLURM
    $0 --list-checkpoints            # Show checkpoint status
    $0 --clear-checkpoint slurm_setup # Clear SLURM checkpoint

COMPONENTS:
    network      - Network configuration and setup
    slurm        - SLURM job scheduler and workload manager
    spack        - Spack package manager for HPC software
    monitoring   - ELK/Grafana monitoring stack
    squid        - HTTP proxy and caching
    apptainer    - Container runtime for reproducible environments
    all          - Install all components (default)

EOF
}

# Function to handle command line arguments
handle_args() {
    local action=""
    local checkpoint=""
    
    # Default to installing all components
    NETWORK_SETUP_ENABLED=true
    SLURM_ENABLED=true
    SPACK_ENABLED=true
    MONITORING_ENABLED=true
    SQUID_ENABLED=true
    APPTAINER_ENABLED=true
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --help)
                show_usage
                exit 0
                ;;
            --list-checkpoints)
                list_checkpoints
                exit 0
                ;;
            --clear-checkpoint)
                checkpoint="$2"
                shift 2
                if [ -n "$checkpoint" ]; then
                    clear_checkpoint "$checkpoint"
                else
                    log_error "Checkpoint name required for --clear-checkpoint"
                    exit 1
                fi
                ;;
            --clear-all-checkpoints)
                clear_all_checkpoints
                exit 0
                ;;
            --step)
                action="$2"
                shift 2
                case $action in
                    network)
                        NETWORK_SETUP_ENABLED=true
                        WAREWULF_ENABLED=false
                        SLURM_ENABLED=false
                        SPACK_ENABLED=false
                        MONITORING_ENABLED=false
                        SQUID_ENABLED=false
                        APPTAINER_ENABLED=false
                        ;;
                    warewulf)
                        NETWORK_SETUP_ENABLED=false
                        WAREWULF_ENABLED=true
                        SLURM_ENABLED=false
                        SPACK_ENABLED=false
                        MONITORING_ENABLED=false
                        SQUID_ENABLED=false
                        APPTAINER_ENABLED=false
                        ;;
                    slurm)
                        NETWORK_SETUP_ENABLED=false
                        WAREWULF_ENABLED=false
                        SLURM_ENABLED=true
                        SPACK_ENABLED=false
                        MONITORING_ENABLED=false
                        SQUID_ENABLED=false
                        APPTAINER_ENABLED=false
                        ;;
                    spack)
                        NETWORK_SETUP_ENABLED=false
                        WAREWULF_ENABLED=false
                        SLURM_ENABLED=false
                        SPACK_ENABLED=true
                        MONITORING_ENABLED=false
                        SQUID_ENABLED=false
                        APPTAINER_ENABLED=false
                        ;;
                    monitoring)
                        NETWORK_SETUP_ENABLED=false
                        WAREWULF_ENABLED=false
                        SLURM_ENABLED=false
                        SPACK_ENABLED=false
                        MONITORING_ENABLED=true
                        SQUID_ENABLED=false
                        APPTAINER_ENABLED=false
                        ;;
                    apptainer)
                        NETWORK_SETUP_ENABLED=false
                        WAREWULF_ENABLED=false
                        SLURM_ENABLED=false
                        SPACK_ENABLED=false
                        MONITORING_ENABLED=false
                        SQUID_ENABLED=false
                        APPTAINER_ENABLED=true
                        ;;
                    all)
                        NETWORK_SETUP_ENABLED=true
                        WAREWULF_ENABLED=true
                        SLURM_ENABLED=true
                        SPACK_ENABLED=true
                        MONITORING_ENABLED=true
                        SQUID_ENABLED=false  # Removed - squid no longer needed with spack
                        APPTAINER_ENABLED=true
                        ;;
                    *)
                        log_error "Invalid step: $action"
                        show_usage
                        exit 1
                        ;;
                esac
                ;;
            *)
                log_error "Unknown option: $1"
                show_usage
                exit 1
                ;;
        esac
    done
}

# Main execution
main() {
    # Check for root privileges
    if [ "$(id -u)" -ne 0 ]; then
        log_error "This script must be run as root"
        exit 1
    fi
    
    # Setup logging
    setup_logging
    
    # Handle command line arguments
    handle_args "$@"
    
    # Validate environment
    if ! validate_environment; then
        log_error "Environment validation failed. Please fix the issues and try again."
        exit 1
    fi
    
    # Run installations
    if ! run_installations; then
        log_error "One or more installation steps failed. Check the logs for details."
        exit 1
    fi
    
    log_info "Setup completed successfully"
    exit 0
}

# Run main function if script is executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
