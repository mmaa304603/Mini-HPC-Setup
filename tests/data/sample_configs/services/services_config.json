{
    "slurm": {
        "version": "23.02",
        "config": {
            "cluster_name": "mini-hpc",
            "control_machine": "head-node",
            "control_addr": "10.0.0.1",
            "slurm_user": "slurm",
            "slurmctld_port": 6817,
            "slurmd_port": 6818,
            "auth_type": "auth/munge",
            "crypto_type": "crypto/munge",
            "state_save_location": "/var/spool/slurm/ctld",
            "slurmd_spool_dir": "/var/spool/slurm/d",
            "switch_type": "switch/none",
            "job_checkpoint_dir": "/var/spool/slurm/checkpoint",
            "proctrack_type": "proctrack/cgroup",
            "return_to_service": 1,
            "slurmctld_pid_file": "/var/run/slurmctld.pid",
            "slurmd_pid_file": "/var/run/slurmd.pid",
            "slurmctld_log_file": "/var/log/slurm/slurmctld.log",
            "slurmd_log_file": "/var/log/slurm/slurmd.log"
        },
        "nodes": {
            "compute-1": {
                "node_name": "compute-1",
                "node_addr": "10.0.1.2",
                "cpus": 4,
                "real_memory": 16384,
                "state": "UNKNOWN"
            },
            "compute-2": {
                "node_name": "compute-2",
                "node_addr": "10.0.1.3",
                "cpus": 4,
                "real_memory": 16384,
                "state": "UNKNOWN"
            }
        },
        "partitions": {
            "debug": {
                "nodes": "compute-[1-2]",
                "default": "YES",
                "max_time": "00:30:00",
                "state": "UP"
            },
            "normal": {
                "nodes": "compute-[1-2]",
                "default": "NO",
                "max_time": "24:00:00",
                "state": "UP"
            }
        }
    },
    "warewulf": {
        "version": "4.3",
        "config": {
            "ipaddr": "10.0.0.1",
            "netmask": "255.255.255.0",
            "network": "10.0.0.0",
            "dhcp_start": "10.0.0.100",
            "dhcp_end": "10.0.0.200",
            "tftp": "/var/lib/tftpboot",
            "chroot": "/var/chroots",
            "container": "/var/containers",
            "database": "/var/lib/warewulf/database.db"
        },
        "nodes": {
            "compute-1": {
                "ipaddr": "10.0.1.2",
                "hwaddr": "00:11:22:33:44:58",
                "container": "rocky9",
                "profile": "compute"
            },
            "compute-2": {
                "ipaddr": "10.0.1.3",
                "hwaddr": "00:11:22:33:44:60",
                "container": "rocky9",
                "profile": "compute"
            }
        }
    },
    "spack": {
        "version": "0.23.1",
        "config": {
            "install_tree": "/opt/spack",
            "module_roots": {
                "tcl": "/opt/spack/modules",
                "lmod": "/opt/spack/lmod"
            },
            "build_stage": "/tmp/spack",
            "source_cache": "/opt/spack/cache",
            "misc_cache": "/opt/spack/cache",
            "template_dirs": ["/opt/spack/templates"]
        },
        "compilers": {
            "gcc": {
                "version": "12.2.0",
                "target": "x86_64",
                "modules": ["gcc/12.2.0"]
            }
        },
        "mpi": {
            "openmpi": {
                "version": "4.1.5",
                "compiler": "gcc@12.2.0",
                "variants": ["+thread_multiple", "+cuda"]
            }
        }
    }
} 