# Squid configuration file
# Generated by Ansible

# Basic Settings
visible_hostname {{ ansible_hostname }}
http_port {{ squid_port }}
cache_mem {{ squid_cache_mem }}
maximum_object_size {{ squid_maximum_object_size }}
cache_dir {{ squid_cache_dir }}
maximum_object_size_in_memory {{ squid_max_object_size_in_memory }}

# Access Control
acl SSL_ports port 443
acl Safe_ports port 80          # http
acl Safe_ports port 443         # https
acl Safe_ports port 70          # gopher
acl Safe_ports port 210         # wais
acl Safe_ports port 1025-65535  # unregistered ports
acl Safe_ports port 280         # http-mgmt
acl Safe_ports port 488         # gss-http
acl Safe_ports port 591         # filemaker
acl Safe_ports port 777         # multiling http
acl CONNECT method CONNECT

# Define allowed networks
{% for network in squid_allowed_networks %}
acl allowed_networks src {{ network }}
{% endfor %}

# Authentication
auth_param basic program {{ squid_auth_program }}
auth_param basic children {{ squid_auth_children }}
auth_param basic realm Squid proxy-caching web server
auth_param basic credentialsttl {{ squid_auth_ttl }}

# Access Rules
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow allowed_networks
http_access deny all

# Logging
access_log {{ squid_access_log }} combined
cache_log {{ squid_cache_log }}
store_log {{ squid_store_log }}

# Performance Tuning
max_filedescriptors {{ squid_max_filedescriptors }}
max_open_disk_fds {{ squid_max_open_disk_fds }}
max_open_fds {{ squid_max_open_fds }}

# SSL Settings
sslcrtd_program {{ squid_ssl_crtd_program }}
sslcrtd_children {{ squid_ssl_crtd_children }}

# Timeouts
connect_timeout {{ squid_connect_timeout }}
read_timeout {{ squid_read_timeout }}
request_timeout {{ squid_request_timeout }}
persist_timeout {{ squid_persist_timeout }}
pinger_timeout {{ squidpinger_timeout }}
ident_timeout {{ squid_ident_timeout }}
negotiate_timeout {{ squid_negotiate_timeout }}
dns_timeout {{ squid_dns_timeout }}
shutdown_lifetime {{ squid_shutdown_lifetime }}

# Refresh Patterns
refresh_pattern ^ftp:           1440    20%     10080
refresh_pattern ^gopher:        1440    0%      1440
refresh_pattern -i (/cgi-bin/|\?) 0     0%      0
refresh_pattern .               0       20%     4320 